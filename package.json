{
  "name": "liying-videomix",
  "private": true,
  "version": "1.0.2",
  "description": "厉影AI混剪：免费开源本地视频合成客户端",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "prepare:channel": "node scripts/prepare-channel.mjs default",
    "sync:brand-icons": "node scripts/sync-brand-icons.mjs && node scripts/prepare-channel.mjs",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && concurrently -n vite,electron -c blue,green \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node ./node_modules/electron/cli.js .\"",
    "electron:start": "npm run build && cross-env node ./node_modules/electron/cli.js .",
    "electron:build": "npm run build && electron-builder --config electron-builder.yml",
    "postinstall": "node ./node_modules/electron/install.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json",
    "test:renderer": "npm run build:electron && node --test tests/local-renderer.test.cjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.14.0",
    "element-plus": "^2.13.6",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8",
    "wait-on": "^8.0.3",
    "esbuild": "^0.25.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  },
  "license": "MIT"
}
